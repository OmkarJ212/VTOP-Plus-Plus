{
  "manifest_version": 3,
  "name": "VTOP++",
  "version": "1.0.0",
  "description": "Enhances VIT Vellore VTOP with batch course material downloads, faculty filtering, attendance calculator, FAT marks predictor, DA deadlines, quick page search (Ctrl+K), and auto-captcha.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "VTOP++ Settings & Dashboard (VIT Vellore)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vtop.vit.ac.in/*"
      ],
      "css": [
        "src/content/styles/themes.css",
        "src/content/styles/navigation.css",
        "src/content/styles/widgets-tools.css",
        "src/content/styles/widgets-dashboard.css",
        "src/content/styles/dark-mode-core.css",
        "src/content/styles/mega-menu.css",
        "src/content/styles/dark-mode-components.css",
        "src/content/styles/dark-mode-widgets.css",
        "src/content/styles/dashboard-and-layout.css",
        "src/content/styles/global-resets.css",
        "src/content/styles/curriculum-and-course.css",
        "src/content/styles/legacy-tables.css",
        "src/content/styles/legacy-pages.css",
        "src/content/styles/profile-page.css",
        "src/content/styles/prelogin-and-error.css"
      ],
      "js": [
        "src/utils/storage.js",
        "src/modules/dark-mode.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://vtop.vit.ac.in/*"
      ],
      "js": [
        "jszip.min.js",
        "src/utils/dom.js",
        "src/utils/ui.js",
        "src/utils/vtop-api.js",
        "src/modules/auto-captcha.js",
        "src/modules/crawler.js",
        "src/modules/menu-drawer.js",
        "src/modules/course-filter.js",
        "src/modules/material-fetcher.js",
        "src/modules/course-downloader.js",
        "src/modules/attendance-calculator.js",
        "src/modules/da-home-card.js",
        "src/modules/da-tracker.js",
        "src/modules/marks-summary.js",
        "src/modules/cgpa-calculator.js",
        "src/modules/marks-fat-predictor.js",
        "src/modules/timetable-ics.js",
        "src/modules/exam-schedule.js",
        "src/modules/timetable-widget.js",
        "src/modules/marks-notifier.js",
        "src/modules/quick-dock.js",
        "src/modules/command-palette.js",
        "src/modules/home-messages.js",
        "src/modules/error-page.js",
        "src/content/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "*://vtop.vit.ac.in/*"
      ],
      "js": [
        "src/content/main-world-patches.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "*://vtop.vit.ac.in/*",
    "https://*.amazonaws.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/velloreWeights.json"
      ],
      "matches": [
        "*://vtop.vit.ac.in/*"
      ]
    }
  ]
}
